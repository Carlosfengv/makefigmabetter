{
  "name": "makefigma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "wasm:build": "bash scripts/build-wasm.sh",
    "protocol:generate": "bash scripts/generate-protocol-types.sh",
    "protocol:check": "pnpm protocol:generate && tsc --project packages/protocol-types/tsconfig.json",
    "check:figma-plugin-contract": "tsc --project tsconfig.figma-plugin-contract.json",
    "check:m0-runtime": "pnpm check:figma-plugin-contract && tsc --project tsconfig.m0-runtime.json && vitest run src/runtime",
    "check:m1-runtime": "pnpm check:m0-runtime && tsc --project tsconfig.runtime-harness.json && vitest run src/lib/editor-protocol.test.ts src/lib/figma-plugin-node-projection.test.ts src/lib/figma-plugin-node-mutation.test.ts src/lib/transaction-batch.test.ts",
    "check:m4-runtime": "pnpm check:m1-runtime && vitest run src/runtime/scene-compiler.test.ts src/runtime/prototype-transition-compositor.test.ts src/lib/svg-export.test.ts src/lib/hit-test.test.ts src/lib/webgpu-scene.test.ts src/lib/render-surface-budget.test.ts src/lib/effect-surface-budget.test.ts src/lib/figma-render-oracle.test.ts src/lib/figma-visual-baseline.test.ts && node --test scripts/create-figma-visual-baseline.test.mjs",
    "check:m5-runtime": "pnpm check:m4-runtime && vitest run src/runtime/smart-animate.test.ts src/runtime/component-variant-state.test.ts src/runtime/prototype-player.test.ts src/runtime/api-prototype-card-flow.test.ts",
    "check:m6-runtime": "pnpm check:m5-runtime && vitest run src/lib/special-node-fallback.test.ts src/lib/connector-path.test.ts src/lib/shape-with-text-path.test.ts src/lib/text-path-layout.test.ts src/lib/m6-special-nodes-fixture.test.ts",
    "check:m7-runtime": "pnpm check:m6-runtime && vitest run src/runtime/plugin-sandbox.test.ts src/runtime/plugin-bundle.test.ts src/runtime/plugin-sandbox-bridge.test.ts src/runtime/plugin-network-proxy.test.ts src/runtime/widget-runtime.test.ts src/runtime/widget-collaboration.test.ts src/components/plugin/plugin-sandbox-frame.test.ts",
    "oracle:figma-render": "node scripts/request-figma-render-oracle.mjs",
    "baseline:figma-visual": "node scripts/create-figma-visual-baseline.mjs",
    "evidence:report": "node scripts/write-phase0-acceptance-report.mjs",
    "evidence:zoom": "bash scripts/capture-zoom-performance-evidence.sh",
    "evidence:phase1-render-composite": "bash scripts/capture-phase1-render-composite-evidence.sh",
    "evidence:phase1-image-recovery": "bash scripts/capture-phase1-image-recovery-evidence.sh",
    "evidence:phase1-gpu-recovery": "bash scripts/capture-phase1-gpu-recovery-evidence.sh",
    "evidence:phase1-gpu-fault": "bash scripts/capture-phase1-gpu-fault-evidence.sh",
    "evidence:phase1-text-caret": "bash scripts/capture-phase1-text-caret-evidence.sh",
    "evidence:phase1-editing": "bash scripts/capture-phase1-editing-evidence.sh",
    "evidence:phase1-operation-hash": "bash scripts/capture-phase1-operation-hash-evidence.sh",
    "evidence:phase1-operation-recovery": "bash scripts/capture-phase1-operation-recovery-evidence.sh",
    "evidence:phase1-gates": "node scripts/capture-phase1-gate-report.mjs",
    "evidence:phase1-stability": "bash scripts/capture-phase1-stability-evidence.sh",
    "evidence:phase2-common-nodes": "bash scripts/capture-phase2-common-nodes-evidence.sh",
    "evidence:phase2-professional-composite": "bash scripts/capture-phase2-professional-composite-evidence.sh",
    "evidence:phase2-professional-composite-stability": "bash scripts/capture-phase2-professional-composite-stability-evidence.sh",
    "evidence:phase2-common-nodes-stability": "bash scripts/capture-phase2-common-nodes-stability-evidence.sh",
    "evidence:phase2-inspector-a11y": "bash scripts/capture-phase2-inspector-a11y-evidence.sh",
    "check:boundaries": "node scripts/check-frontend-boundaries.mjs",
    "check:compatibility": "node scripts/check-compatibility-matrix.mjs",
    "check:phase1-text-fixture": "node scripts/verify-phase1-text-fixture.mjs",
    "check:phase1-text-10k-fixture": "node scripts/verify-phase1-text-10k-fixture.mjs",
    "check:phase1-shape-100k-fixture": "node scripts/verify-phase1-shape-100k-fixture.mjs",
    "check:phase1-asset-hostile-fixture": "node scripts/verify-phase1-asset-hostile-fixture.mjs",
    "check:phase1-render-composite-fixture": "node scripts/verify-phase1-render-composite-fixture.mjs",
    "check:phase2-common-nodes-fixture": "node scripts/verify-phase2-common-nodes-fixture.mjs",
    "check:phase2-professional-composite-golden": "node scripts/verify-phase2-professional-composite-golden.mjs",
    "check:phase1-snapshot-fixtures": "node scripts/verify-phase1-snapshot-fixtures.mjs",
    "mock:backend": "node services/mock-backend/server.mjs",
    "mock:backend:check": "node services/mock-backend/check.mjs",
    "workspace:api": "node services/workspace-api/server.mjs",
    "workspace:api:check": "node services/workspace-api/check.mjs",
    "document:api": "cargo run -p makefigma-document-api",
    "document:api:check": "cargo test -p makefigma-document-api",
    "asset:api": "cargo run -p makefigma-asset-api",
    "asset:api:check": "cargo test -p makefigma-asset-api",
    "start": "next start",
    "lint": "eslint src scripts services packages next.config.ts --no-error-on-unmatched-pattern",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@makefigma/protocol-types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.12.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.134.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "ts-proto": "^2.12.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
